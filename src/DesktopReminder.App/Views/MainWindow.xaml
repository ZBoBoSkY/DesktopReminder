<views:ThemeWindow x:Class="DesktopReminder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="桌面轻提醒"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResize" SizeToContent="Height"
        Width="372" MinWidth="300" MaxWidth="540" MinHeight="220"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        MouseEnter="Window_MouseEnter" Activated="Window_Activated"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">

    <views:ThemeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
        <views:DueForegroundConverter x:Key="DueForeground"/>

        <!-- 图标字体（系统矢量图标，非 emoji，随主题换色） -->
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- 标题栏按钮（Apple 风格：悬停微亮、按下即反馈缩放） -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务行小按钮：图标型继承 TitleButton 的图标字体；文字型按钮显式指定雅黑 -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 任务行容器（悬停反馈；过期任务红色底醒目） -->
        <Style x:Key="RowContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDue}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDueSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 内联新建输入框（圆角 8，聚焦时描边变强调色） -->
        <Style x:Key="InlineTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 时长胶囊（RadioButton 自管理互斥选中态；选中 = 强调色底白字） -->
        <Style x:Key="MinuteCapsule" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Padding="14,5"
                                Background="{DynamicResource ThemeHover}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ThemeWindow.Resources>

    <!-- 外层大圆角卡片 + 阴影（FlClash：大圆角 20，无描边靠深浅分层） -->
    <Border CornerRadius="20" Margin="0"
            Background="{DynamicResource ThemeSurface}"
            BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <!-- Grid 布局：进行中任务用 * 高度永远优先占空间，面板放下面，窗口再矮也先保进行中任务可见 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Height="40" Background="Transparent"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- 主题色小圆点 logo -->
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource ThemeAccent}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="{DynamicResource ThemeForeground}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE710;" ToolTip="新建任务"
                                Command="{Binding AddTaskCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE949;" ToolTip="收成悬浮图标"
                                Command="{Binding MinimizeToIconCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE73E;" ToolTip="已完成任务"
                                Command="{Binding ToggleCompletedCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE74D;" ToolTip="已删除任务"
                                Command="{Binding ToggleDeletedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 到期提示条（有任务到期/过期时醒目提示，点击直达第一个到期任务） ============ -->
            <Border Grid.Row="1"
                    Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ThemeDueSoft}"
                    Margin="8,2,8,4" CornerRadius="10" Padding="10,5"
                    MouseLeftButtonDown="DueBanner_Click" Cursor="Hand" ToolTip="点击查看到期任务">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource ThemeDue}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DueBannerText}"
                               Foreground="{DynamicResource ThemeDue}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- ============ 已删除面板 ============ -->
            <Border Grid.Row="4" Visibility="{Binding DeletedPanelVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20"
                    Background="{DynamicResource ThemeBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已删除（可恢复）"
                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                               Margin="16,8,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="已删除库为空" FontSize="11" Margin="16,2,0,4"
                               Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.6"
                               Visibility="{Binding HasDeleted, Converter={StaticResource InvertBoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                        <ItemsControl ItemsSource="{Binding DeletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="1"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 图标列（与进行中行一致） -->
                                                <Grid Grid.Column="0" Width="24" Height="24"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border CornerRadius="7" Background="{DynamicResource ThemeHover}">
                                                        <TextBlock Text="{Binding InitialLetter}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeSecondaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding AppIcon}" Width="22" Height="22" Stretch="Uniform"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Note, StringFormat= · {0}}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="恢复"
                                                        ToolTip="从已删除中恢复" Command="{Binding RestoreCommand}"/>
                                                <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        ToolTip="彻底删除" Foreground="{DynamicResource ThemeDue}"
                                                        Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 已完成面板 ============ -->
            <Border Grid.Row="3" Visibility="{Binding CompletedPanelVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20"
                    Background="{DynamicResource ThemeBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已完成（可恢复激活）"
                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                               Margin="16,8,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="已完成库为空" FontSize="11" Margin="16,2,0,4"
                               Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.6"
                               Visibility="{Binding HasCompleted, Converter={StaticResource InvertBoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                        <ItemsControl ItemsSource="{Binding CompletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="1"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 图标列（与进行中行一致） -->
                                                <Grid Grid.Column="0" Width="24" Height="24"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border CornerRadius="7" Background="{DynamicResource ThemeHover}">
                                                        <TextBlock Text="{Binding InitialLetter}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeSecondaryText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Image Source="{Binding AppIcon}" Width="22" Height="22" Stretch="Uniform"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Note, StringFormat= · {0}}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text=" · 完成于 " Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"/>
                                                    <TextBlock Text="{Binding CompletedAtText}" Foreground="{DynamicResource ThemeActive}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="激活"
                                                        ToolTip="重新激活此任务" Command="{Binding RestoreCommand}"/>
                                                <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        ToolTip="删除（可恢复）" Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 任务区（内联新建置顶，列表跟随；进行中任务优先级最高） ============ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 内联新建行（第 3 步）：软件名自动填好 → 光标停备注 → 回车保存 Esc 取消 -->
                <Border Grid.Row="0" Margin="8,2,8,6" Padding="10,8" CornerRadius="12"
                        Background="{DynamicResource ThemeHover}"
                        Visibility="{Binding InlineAddVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InlineAppNameBox" Grid.Column="0" Style="{StaticResource InlineTextBox}"
                                     Text="{Binding InlineAppName, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="InlineInput_KeyDown"/>
                            <TextBox x:Name="InlineNoteBox" Grid.Column="1" Margin="6,0,0,0"
                                     Style="{StaticResource InlineTextBox}"
                                     Text="{Binding InlineNote, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="InlineInput_KeyDown"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Style="{StaticResource RowButton}" Content="&#xE73E;" Foreground="{DynamicResource ThemeActive}"
                                        ToolTip="保存任务" Command="{Binding SaveInlineCommand}"/>
                                <Button Style="{StaticResource RowButton}" Content="&#xE711;" Foreground="{DynamicResource ThemeSecondaryText}"
                                        ToolTip="取消（Esc）" Command="{Binding CancelInlineCommand}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="时长：" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"
                                       VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{x:Static views:MainWindow.InlineMinutesSource}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource MinuteCapsule}" GroupName="InlineMinute"
                                                     Content="{Binding}"
                                                     Command="{Binding DataContext.SelectMinuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="回车保存 · Esc 取消" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="TaskScroll" VerticalScrollBarVisibility="Auto" MaxHeight="430" MinHeight="64">
                <Grid>
                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowContainer}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="1"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标列：真实软件图标（按 exe 取），取不到时显示首字母圆角块 -->
                                            <Grid Grid.Column="0" Width="26" Height="26"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border CornerRadius="7" Background="{DynamicResource ThemeHover}">
                                                    <TextBlock Text="{Binding InitialLetter}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThemeSecondaryText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding AppIcon}" Width="24" Height="24" Stretch="Uniform"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>

                                            <!-- 名称（14 SemiBold）+ 备注（12 次要色）：两级字体层级 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding AppName}"
                                                           Foreground="{DynamicResource ThemeForeground}" FontSize="14"
                                                           FontWeight="SemiBold" LineHeight="22"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Note}"
                                                           Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12"
                                                           LineHeight="18"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- 倒计时（等宽数字，双击新建，冻结需求） -->
                                            <!-- 颜色用 DynamicResource + DataTrigger：主题切换自动刷新 -->
                                            <TextBlock Grid.Column="2" Text="{Binding CountdownText}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       FontFamily="Consolas, Microsoft YaHei"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                                       MouseLeftButtonDown="Countdown_MouseLeftButtonDown">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDue}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeDue}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 悬停操作区：完成/稍后/删除，鼠标移到任务行上才出现（平时界面干净） -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource RowButton}" Content="&#xE73E;"
                                                        Foreground="{DynamicResource ThemeActive}"
                                                        ToolTip="完成任务" Command="{Binding CompleteCommand}"/>
                                                <Button Style="{StaticResource RowButton}" Content="稍后"
                                                        ToolTip="稍后提醒" Command="{Binding SnoozeCommand}"/>
                                                <Button Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        Foreground="{DynamicResource ThemeDue}"
                                                        ToolTip="删除（可恢复）" Command="{Binding DeleteCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                   Margin="12,0,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：大号 + 图标 + 文字垂直居中，悬停变蓝可点 -->
                    <StackPanel Visibility="{Binding EmptyHintVisible, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="True"
                                MouseLeftButtonDown="EmptyHint_MouseLeftButtonDown"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="Hand">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="双击新建任务（或按 Ctrl+Alt+N）" FontSize="12" Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>

        </Grid>
    </Border>
</views:ThemeWindow>
