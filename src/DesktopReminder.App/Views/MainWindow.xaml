<views:ThemeWindow x:Class="DesktopReminder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="桌面轻提醒"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResize" SizeToContent="Height"
        Width="372" MinWidth="300" MaxWidth="540"
        MouseEnter="Window_MouseEnter" Activated="Window_Activated"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">

    <views:ThemeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
        <views:DueForegroundConverter x:Key="DueForeground"/>

        <!-- 图标字体（系统矢量图标，非 emoji，随主题换色） -->
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- 标题栏按钮（Apple 风格：悬停微亮、按下即反馈缩放） -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务行小按钮（文字型） -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 任务行容器（悬停反馈；过期任务红色底醒目） -->
        <Style x:Key="RowContainer" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDue}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDueSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ThemeWindow.Resources>

    <!-- 外层大圆角卡片 + 阴影（FlClash：大圆角 20，无描边靠深浅分层） -->
    <Border CornerRadius="20" Margin="10"
            Background="{DynamicResource ThemeSurface}"
            BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <DockPanel>

            <!-- ============ 标题栏 ============ -->
            <Border DockPanel.Dock="Top" Height="40" Background="Transparent"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- 主题色小圆点 logo -->
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource ThemeAccent}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="{DynamicResource ThemeForeground}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE710;" ToolTip="新建任务"
                                Command="{Binding AddTaskCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE949;" ToolTip="收成悬浮图标"
                                Command="{Binding MinimizeToIconCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE73E;" ToolTip="已完成任务"
                                Command="{Binding ToggleCompletedCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="&#xE74D;" ToolTip="已删除任务"
                                Command="{Binding ToggleDeletedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 到期提示条（有任务到期/过期时醒目提示） ============ -->
            <Border DockPanel.Dock="Top"
                    Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ThemeDueSoft}"
                    Margin="8,2,8,4" CornerRadius="10" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource ThemeDue}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DueBannerText}"
                               Foreground="{DynamicResource ThemeDue}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- ============ 已删除面板（底部） ============ -->
            <Border DockPanel.Dock="Bottom" Visibility="{Binding DeletedPanelVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    MaxHeight="200" Background="{DynamicResource ThemeBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已删除（可恢复）"
                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                               Margin="16,8,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="已删除库为空" FontSize="11" Margin="16,2,0,4"
                               Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.6"
                               Visibility="{Binding HasDeleted, Converter={StaticResource InvertBoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DeletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="1"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Note, StringFormat= · {0}}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource RowButton}" Content="恢复"
                                                        Command="{Binding RestoreCommand}"/>
                                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        ToolTip="彻底删除" Foreground="{DynamicResource ThemeDue}"
                                                        Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 已完成面板 ============ -->
            <Border DockPanel.Dock="Bottom" Visibility="{Binding CompletedPanelVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    MaxHeight="200" Background="{DynamicResource ThemeBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已完成（可恢复激活）"
                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                               Margin="16,8,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="已完成库为空" FontSize="11" Margin="16,2,0,4"
                               Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.6"
                               Visibility="{Binding HasCompleted, Converter={StaticResource InvertBoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CompletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowContainer}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="1"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Height="36">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12"/>
                                                    <TextBlock Text="{Binding Note, StringFormat= · {0}}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text=" · 完成于 " Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"/>
                                                    <TextBlock Text="{Binding CompletedAtText}" Foreground="{DynamicResource ThemeActive}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource RowButton}" Content="激活"
                                                        ToolTip="重新激活此任务" Command="{Binding RestoreCommand}"/>
                                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        ToolTip="删除（可恢复）" Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 任务列表（进行中） ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                <Grid>
                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowContainer}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="1"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Height="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 第一列：倒计时（双击新建，冻结需求） -->
                                            <TextBlock Grid.Column="0" Text="{Binding CountdownText}"
                                                       Foreground="{Binding IsDue, Converter={StaticResource DueForeground}}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       FontFamily="Consolas, Microsoft YaHei"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       MouseLeftButtonDown="Countdown_MouseLeftButtonDown"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AppName}"
                                                               Foreground="{DynamicResource ThemeForeground}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- 状态圆点：绿=倒计时中 / 红=已到期 -->
                                                    <Ellipse Width="5" Height="5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource ThemeActive}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDue}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource ThemeDue}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}"
                                                           Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="&#xE73E;"
                                                    ToolTip="完成任务" Command="{Binding CompleteCommand}"/>
                                            <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="稍后"
                                                    ToolTip="稍后提醒" Command="{Binding SnoozeCommand}"/>
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource ThemeBorder}"
                                                   Margin="12,0,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：三行空列表，第一行浅字提示（双击新建） -->
                    <StackPanel Visibility="{Binding EmptyHintVisible, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="True"
                                MouseLeftButtonDown="EmptyHint_MouseLeftButtonDown">
                        <TextBlock Text="双击新建任务" FontSize="12" Margin="74,16,0,0"
                                   Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.55"
                                   Cursor="Hand"/>
                        <Rectangle Height="44" Fill="Transparent"/>
                        <Rectangle Height="44" Fill="Transparent"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </DockPanel>
    </Border>
</views:ThemeWindow>
