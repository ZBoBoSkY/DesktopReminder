<views:ThemeWindow x:Class="DesktopReminder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="桌面轻提醒"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="CanResize" SizeToContent="Height"
        Width="360" MinWidth="280" MaxWidth="520"
        MouseEnter="Window_MouseEnter" Activated="Window_Activated"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">

    <views:ThemeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:DueForegroundConverter x:Key="DueForeground"/>

        <!-- 标题栏小图标按钮 -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任务行小按钮 -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </views:ThemeWindow.Resources>

    <!-- 外层圆角卡片 -->
    <Border CornerRadius="12" Margin="6"
            Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <DockPanel>

            <!-- ============ 标题栏（整行可拖拽，按钮区除外，WM_NCHITTEST 处理） ============ -->
            <Border DockPanel.Dock="Top" Height="36" Background="Transparent">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="{DynamicResource ThemeForeground}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleButton}" Content="＋" ToolTip="新建任务"
                                Command="{Binding AddTaskCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="－" ToolTip="收成悬浮图标"
                                Command="{Binding MinimizeToIconCommand}"/>
                        <Button Style="{StaticResource TitleButton}" Content="✓" ToolTip="已完成任务"
                                Command="{Binding ToggleCompletedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 已完成面板（底部，点击 ✓ 展开） ============ -->
            <Border DockPanel.Dock="Bottom" Visibility="{Binding CompletedPanelVisible, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                    MaxHeight="180" Background="{DynamicResource ThemeBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="已完成"
                               Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                               Margin="14,6,0,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CompletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36" Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12"/>
                                            <TextBlock Text=" · 完成于 " Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"/>
                                            <TextBlock Text="{Binding CompletedAtText}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource RowButton}" Content="恢复"
                                                Command="{Binding RestoreCommand}"/>
                                        <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="×"
                                                ToolTip="删除" Command="{Binding DeleteCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 任务列表 ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <Grid>
                    <ItemsControl ItemsSource="{Binding ActiveTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第一列：倒计时（双击新建任务，冻结需求） -->
                                    <TextBlock Grid.Column="0" Text="{Binding CountdownText}"
                                               Foreground="{Binding IsDue, Converter={StaticResource DueForeground}}"
                                               FontSize="14" FontWeight="SemiBold"
                                               FontFamily="Consolas, Microsoft YaHei"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               MouseLeftButtonDown="Countdown_MouseLeftButtonDown"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding AppName}"
                                                   Foreground="{DynamicResource ThemeForeground}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}"
                                                   Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource RowButton}" Content="✓"
                                            ToolTip="完成任务" Command="{Binding CompleteCommand}"/>
                                    <Button Grid.Column="3" Style="{StaticResource RowButton}" Content="稍后"
                                            ToolTip="稍后提醒" Command="{Binding SnoozeCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：三行空列表，第一行浅字提示 -->
                    <StackPanel Visibility="{Binding EmptyHintVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="双击新建任务" FontSize="12" Margin="66,14,0,0"
                                   Foreground="{DynamicResource ThemeSecondaryText}" Opacity="0.55"/>
                        <Rectangle Height="44" Fill="Transparent"/>
                        <Rectangle Height="44" Fill="Transparent"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </DockPanel>
    </Border>
</views:ThemeWindow>
