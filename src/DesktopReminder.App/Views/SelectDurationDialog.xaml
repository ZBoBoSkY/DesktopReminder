<views:ThemeWindow x:Class="DesktopReminder.App.Views.SelectDurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="稍后提醒" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="320" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeForeground}">

    <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="TitleText" Text="稍后多久提醒？" FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,14"/>

        <UniformGrid x:Name="OptionGrid" Columns="2" Rows="2"/>

        <Button Content="取消" MinWidth="80" Height="32" HorizontalAlignment="Right" Margin="0,18,0,0"
                Click="Cancel_Click"/>
    </StackPanel>
</views:ThemeWindow>
