<views:ThemeWindow x:Class="DesktopReminder.App.Views.AddTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新建任务" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="360" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeForeground}">

    <views:ThemeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:ThemeWindow.Resources>

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="新建任务" FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,14"/>

        <!-- 软件名称（自动识别填充，可修改） -->
        <TextBlock Text="软件名称" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"/>
        <TextBox x:Name="AppNameBox" Margin="0,4,0,12" FontSize="13"
                 Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- 备注 -->
        <TextBlock Text="备注（这个软件在做什么事，可留空）" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"/>
        <TextBox Margin="0,4,0,12" FontSize="13"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- 时长 -->
        <TextBlock Text="提醒时长" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <ComboBox Width="140" VerticalAlignment="Center"
                      SelectedIndex="{Binding SelectedOptionIndex}">
                <ComboBoxItem Content="5 分钟"/>
                <ComboBoxItem Content="10 分钟"/>
                <ComboBoxItem Content="15 分钟"/>
                <ComboBoxItem Content="30 分钟"/>
                <ComboBoxItem Content="60 分钟"/>
                <ComboBoxItem Content="自定义"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCustomVisible, Converter={StaticResource BoolToVis}}">
                <TextBox Width="64" FontSize="13"
                         Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="分钟" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" MinWidth="80" Height="32" Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>
            <ui:Button Appearance="Primary" Content="确定" MinWidth="80" Height="32"
                    Command="{Binding OkCommand}"/>
        </StackPanel>
    </StackPanel>
</views:ThemeWindow>
