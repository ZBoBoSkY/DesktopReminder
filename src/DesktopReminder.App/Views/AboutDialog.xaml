<views:ThemeWindow x:Class="DesktopReminder.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="关于" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="380" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeForeground}">

    <StackPanel Margin="22,20,22,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Ellipse Width="40" Height="40" Fill="{DynamicResource ThemeAccent}">
                <Ellipse.Resources>
                    <Style TargetType="Ellipse"/>
                </Ellipse.Resources>
            </Ellipse>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="桌面轻提醒" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeForeground}"/>
                <TextBlock Text="DesktopReminder" FontSize="11"
                           Foreground="{DynamicResource ThemeSecondaryText}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="版本 v0.3.0" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="13" LineHeight="22"
                   Foreground="{DynamicResource ThemeForeground}"
                   Text="一个轻量的桌面任务提醒工具：记录你正在做的每件事（软件名 + 备注），
到时自动提醒；不打扰时自动收成半透明、再收成悬浮图标，全程不影响你正常浏览。"/>

        <Separator Margin="0,14,0,10" Background="{DynamicResource ThemeBorder}"/>

        <TextBlock Text="特色" FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeForeground}"/>
        <TextBlock Text="· 自动识别前台软件名称，一键建档&#10;· 清晰/半透明/图标三态自动切换，永不失联&#10;· 圆形图标 + 倒计时标签 + 对角角标&#10;· 深色/浅色主题跟随系统&#10;· 便携版，解压即用，数据就在软件目录"
                   FontSize="12" LineHeight="20" Margin="0,6,0,0"
                   Foreground="{DynamicResource ThemeSecondaryText}"/>

        <Button Content="关闭" Width="88" Height="30" HorizontalAlignment="Right" Margin="0,18,0,0"
                Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0"
                Click="Close_Click"/>
    </StackPanel>
</views:ThemeWindow>
