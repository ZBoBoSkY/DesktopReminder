<views:ThemeWindow x:Class="DesktopReminder.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        Title="设置" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="400" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeForeground}">

    <views:ThemeWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </views:ThemeWindow.Resources>

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="设置" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeForeground}"/>

        <TextBlock Style="{StaticResource Label}" Text="清晰 → 半透明 无操作超时（分钟）"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Style="{StaticResource NumBox}" Text="{Binding GlassMinutes, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="半透明 → 图标 无操作超时（秒）"/>
        <TextBox Style="{StaticResource NumBox}" Text="{Binding IconSeconds, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource Label}" Text="半透明状态不透明度（%，5~90）"/>
        <TextBox Style="{StaticResource NumBox}" Text="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource Label}" Text="过期任务重复提醒间隔（分钟）"/>
        <TextBox Style="{StaticResource NumBox}" Text="{Binding RemindIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource Label}" Text="新建任务默认时长（分钟）"/>
        <TextBox Style="{StaticResource NumBox}" Text="{Binding DefaultMinutes, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource Label}" Text="主题"/>
        <ComboBox Width="160" HorizontalAlignment="Left"
                  Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeForeground}"
                  BorderBrush="{DynamicResource ThemeBorder}"
                  ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}"/>

        <CheckBox Content="声音提醒" Margin="0,12,0,0" Foreground="{DynamicResource ThemeForeground}"
                  IsChecked="{Binding SoundEnabled}"/>
        <CheckBox Content="开机自启" Margin="0,8,0,0" Foreground="{DynamicResource ThemeForeground}"
                  IsChecked="{Binding AutoStart}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="76" Height="30" Margin="0,0,10,0"
                    Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeForeground}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    Command="{Binding CancelCommand}"/>
            <Button Content="保存" Width="76" Height="30"
                    Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</views:ThemeWindow>
