<views:ThemeWindow x:Class="DesktopReminder.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopReminder.App.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" WindowStartupLocation="CenterScreen"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeForeground}">

    <views:ThemeWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </views:ThemeWindow.Resources>

    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="设置" FontSize="{StaticResource FontSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,10"/>

        <!-- 每一行：标签 + 输入框同一行左对齐 -->
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0"
                       Text="清晰 → 半透明 无操作超时（分钟）"/>
            <TextBox Style="{StaticResource NumBox}" Grid.Column="1"
                     Text="{Binding GlassMinutes, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0"
                       Text="半透明 → 图标 无操作超时（秒）"/>
            <TextBox Style="{StaticResource NumBox}" Grid.Column="1"
                     Text="{Binding IconSeconds, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0"
                       Text="半透明状态不透明度（%）"/>
            <TextBox Style="{StaticResource NumBox}" Grid.Column="1"
                     Text="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0"
                       Text="过期任务重复提醒间隔（分钟）"/>
            <TextBox Style="{StaticResource NumBox}" Grid.Column="1"
                     Text="{Binding RemindIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0"
                       Text="新建任务默认时长（分钟）"/>
            <TextBox Style="{StaticResource NumBox}" Grid.Column="1"
                     Text="{Binding DefaultMinutes, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Grid.Column="0" Text="主题"/>
            <ComboBox Grid.Column="1" Width="150"
                      ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}"/>
        </Grid>

        <CheckBox Content="声音提醒" Margin="0,12,0,0"
                  IsChecked="{Binding SoundEnabled}"/>
        <CheckBox Content="开机自启" Margin="0,8,0,0"
                  IsChecked="{Binding AutoStart}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" MinWidth="80" Height="32" Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="应用" MinWidth="80" Height="32" Margin="0,0,10,0"
                    Command="{Binding ApplyCommand}"/>
            <ui:Button Appearance="Primary" Content="保存" MinWidth="80" Height="32"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</views:ThemeWindow>
