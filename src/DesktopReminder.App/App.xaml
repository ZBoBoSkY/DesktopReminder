<Application x:Class="DesktopReminder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI：Windows 11 Fluent 2 控件样式（按钮/输入框/下拉框/复选框/滚动条/菜单/提示）。
                     主题与强调色由 ThemeManager 统一同步，不在这里写死 -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Fluent 字体层级 =====
                 英文/数字走 Segoe UI Variable（Win11 系统字体），中文回退微软雅黑 UI；
                 Win10 没有 Variable 时自动退到 Segoe UI。 -->
            <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
            <!-- 图标：Win11 用 Segoe Fluent Icons，Win10 回退 MDL2（码位一致） -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- 字号：Caption 12 / Body 14 / Subtitle 20（Fluent type ramp） -->
            <system:Double x:Key="FontCaption" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
            <system:Double x:Key="FontBody" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
            <system:Double x:Key="FontSubtitle" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>

            <!-- 圆角：窗口/卡片 8，控件/任务行 4（Win11 规范） -->
            <CornerRadius x:Key="RadiusOverlay">8</CornerRadius>
            <CornerRadius x:Key="RadiusControl">4</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
